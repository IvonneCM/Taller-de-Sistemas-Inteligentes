# Destino del proxy del servidor de desarrollo (solo `npm run dev`).
# Copiar como .env.render (para `npm run dev:render`) o .env.local (para `npm run dev`).
# Sin barra final y sin rutas: la interfaz agrega /auth/login, /zonas/riesgo, etc.
# No son secretos (la URL de la API es publica), pero cada entorno tiene la suya.
#
# API desplegada:
API_TARGET=https://<su-servicio>.onrender.com
# API local (valor por defecto si no se define nada):
# API_TARGET=http://localhost:8000
