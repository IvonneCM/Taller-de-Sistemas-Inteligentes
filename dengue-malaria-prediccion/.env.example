# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir el archivo .env real al repositorio.

# --- Base de datos (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dengue_malaria

# --- Seguridad / JWT ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Identificador del emisor incluido y validado en los JWT.
JWT_ISSUER=dengue-malaria-api

# --- Entorno ---
ENVIRONMENT=development

# --- Seed de desarrollo (NUNCA completar con una clave real en el repo) ---
# Password para los usuarios @demo.local de app/etl/seed_usuarios.py.
# Cada desarrollador la define solo en su .env local.
SEED_DEMO_PASSWORD=

# --- Fuentes de datos externas (completar cuando se resuelvan las preguntas
#     abiertas de design.md §10) ---
CLIMA_API_URL=
CLIMA_API_KEY=
EPIDEMIOLOGIA_FUENTE_URL=
