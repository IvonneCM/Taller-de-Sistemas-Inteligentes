# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir el archivo .env real al repositorio.

# --- Base de datos (PostgreSQL + PostGIS) ---
# Debe coincidir con POSTGRES_* y POSTGRES_HOST_PORT de abajo.
DATABASE_URL=postgresql://postgres:cambiar-esta-clave@localhost:5433/dengue_malaria

# --- Contenedor local de PostgreSQL + PostGIS (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=dengue_malaria
POSTGRES_HOST_PORT=5433

# --- Seguridad / JWT ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Identificador del emisor incluido y validado en los JWT.
JWT_ISSUER=dengue-malaria-api

# --- Entorno ---
ENVIRONMENT=development

# --- Diagnostico y limites de espera (valores por defecto; opcionales) ---
# LOG_LEVEL=INFO
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_POOL_TIMEOUT_SECONDS=10

# --- Seed de desarrollo (NUNCA completar con una clave real en el repo) ---
# Password para los usuarios @demo.local de app/etl/seed_usuarios.py.
# Cada desarrollador la define solo en su .env local.
SEED_DEMO_PASSWORD=

# --- Fuentes de datos externas (completar cuando se resuelvan las preguntas
#     abiertas de design.md §10) ---
CLIMA_API_URL=
CLIMA_API_KEY=
EPIDEMIOLOGIA_FUENTE_URL=
